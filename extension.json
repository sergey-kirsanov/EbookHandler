{
	"name": "EPUB Handler",
	"author": [
		"Sergey Kirsanov"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:EpubHandler",
	"descriptionmsg": "epub-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "media",
	"requires": {
		"MediaWiki": ">= 1.43"
	},
	"config": {
		"EpubHandlerDpi": {
			"value": 150
		},
		"EpubHandlerPostProcessor": {
			"value": "/usr/bin/convert"
		},
		"EpubHandlerJpegQuality": {
			"value": 95
		}
	},
	"MessagesDirs": {
		"EpubHandler": [
			"i18n"
		]
	},
	"ResourceModules": {
		"epubhandler.messages": {
			"messages": [
				"ebup-file-page-warning",
				"ebup-file-page-warning-header",
				"ebup-file-page-warning-info",
				"ebup-file-page-warning-footer"
			]
		}
	},
	"MediaHandlers": {
		"application/epub+zip": "MediaWiki\\Extension\\EpubHandler\\EpubHandler"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\EpubHandler\\": "includes/"
	},
	"manifest_version": 2
}
