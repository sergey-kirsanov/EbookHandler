{
	"name": "EBOOK Handler",
	"version": "1.0.0",
	"author": [
		"Sergey Kirsanov"
	],
	"url": "https://github.com/sergey-kirsanov/EbookHandler",
	"descriptionmsg": "ebookhandler-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "media",
	"requires": {
		"MediaWiki": ">= 1.43"
	},
	"config": {
		"EbookHandlerOutputExtension": {
			"value": "jpg"
		},
		"EbookHandlerDpi": {
			"value": 150
		},
		"EbookHandlerPostProcessor": {
			"value": "/usr/bin/convert"
		},
		"EbookHandlerJpegQuality": {
			"value": 95
		}
	},
	"MessagesDirs": {
		"EpubHandler": [
			"i18n"
		]
	},
	"MediaHandlers": {
		"application/epub+zip": "MediaWiki\\Extension\\EbookHandler\\Formats\\EpubHandler",
		"application/x-fictionbook+xml": "MediaWiki\\Extension\\EbookHandler\\Formats\\Fb2Handler",
		"application/x-mobipocket-ebook": "MediaWiki\\Extension\\EbookHandler\\Formats\\MobiHandler"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\EbookHandler\\": "includes/",
		"MediaWiki\\Extension\\EbookHandler\\formats": "includes/formats"
	},
	"manifest_version": 2
}
